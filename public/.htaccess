AddDefaultCharset UTF-8
AddCharset UTF-8 .html .css .js .txt .json
ErrorDocument 404 /404.html
DirectoryIndex index.html index.php

<IfModule mod_mime.c>
  AddType video/mp4 .mp4 .m4v
  AddType video/webm .webm
</IfModule>

<IfModule mod_headers.c>
  Header set X-Robots-Tag "index, follow"

  # 1. Content Security Policy (CSP) Atualizado com media-src para liberar vídeos no iOS/Safari
  Header always set Content-Security-Policy "default-src 'self'; media-src 'self' blob: data: https:; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://static.cloudflareinsights.com https://maps.googleapis.com https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https: https://maps.gstatic.com https://*.googleapis.com https://*.ggpht.com https://www.gstatic.com/recaptcha/; font-src 'self' data: https: https://fonts.gstatic.com; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com https://api.staticforms.xyz https://wa.me https://maps.googleapis.com https://www.google.com/recaptcha/; frame-src 'self' https://www.google.com https://www.google.com.br https://www.google.com/recaptcha/ https://recaptcha.google.com/; manifest-src 'self'; upgrade-insecure-requests"

  # 2. HSTS
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # 3. COOP
  Header always set Cross-Origin-Opener-Policy "same-origin"

  # Outros cabeçalhos de proteção
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set X-Frame-Options "SAMEORIGIN"

  # Força o suporte a Byte-Range Requests (HTTP 206) exigido pelo Safari/iOS
  Header set Accept-Ranges bytes
</IfModule>

<IfModule mod_rewrite.c>
RewriteEngine On

  # Bloqueia apenas User-Agents estritamente vazios ou traço
  RewriteCond %{HTTP_USER_AGENT} ^-?$ [NC,OR]
  RewriteCond %{HTTP_USER_AGENT} ^$
  RewriteRule ^ - [F,L]

  # Bloqueia bots conhecidos
  RewriteCond %{HTTP_USER_AGENT} \b(baiduspider|researchbot|trendiction|nutch|seekbot)\b [NC]
  RewriteRule ^ - [F,L]

  # Forçar HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule (.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Redirecionamento do WhatsApp
  RewriteRule ^whatsapp/?$ "https://wa.me/5521999677722?text=Ol%C3%A1!+Visitei+seu+Instagram+e+quero+saber+como+economizar+com+Energia+Solar" [R=301,L,NE]
  
  # Nunca reescrever assets estáticos (chunks, css, imagens, mídias)
  RewriteRule ^_next/ - [L]
  RewriteCond %{REQUEST_URI} \.(?:js|css|map|json|txt|xml|ico|png|jpe?g|gif|webp|avif|svg|woff2?|mp4|m4v|webm)$ [NC]
  RewriteRule ^ - [L]

  # Garante que pastas de rotas estáticas com index.html sejam servidas corretamente em hosts Apache/cPanel
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.+)$ /$1/index.html [L]

  # 1. Remove a barra do final da URL se ela existir (ex: /termos-de-uso/ -> /termos-de-uso)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [L,R=301]

  # 2. Mapeia rotas para arquivos .html estáticos (ex: /termos-de-uso -> /termos-de-uso.html)
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # 3. Regras padrão do site (Fallback SPA)
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Evita HTML em cache antigo apontando para chunks removidos.
  <FilesMatch "\.(?:html)$">
    Header always set Cache-Control "max-age=0, must-revalidate"
    Header unset Pragma
    Header unset Expires
  </FilesMatch>

  <FilesMatch "\.(?:js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Gzip para compactar os arquivos ao navegador.
<IfModule mod_deflate.c>
  # Impede compactação em arquivos de áudio/vídeo para não quebrar streaming do Safari
  SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|mp4|webm)$ no-gzip dont-vary

  AddOutputFilterByType DEFLATE text/plain  
  AddOutputFilterByType DEFLATE text/xml  
  AddOutputFilterByType DEFLATE application/xhtml+xml  
  AddOutputFilterByType DEFLATE text/css  
  AddOutputFilterByType DEFLATE application/xml  
  AddOutputFilterByType DEFLATE image/svg+xml  
  AddOutputFilterByType DEFLATE application/rss+xml  
  AddOutputFilterByType DEFLATE application/atom_xml  
  AddOutputFilterByType DEFLATE application/x-javascript  
  AddOutputFilterByType DEFLATE application/javascript  
  AddOutputFilterByType DEFLATE application/x-httpd-php  
  AddOutputFilterByType DEFLATE application/x-httpd-fastphp  
  AddOutputFilterByType DEFLATE application/x-httpd-eruby  
  AddOutputFilterByType DEFLATE text/html  
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  
  # Imagens e mídias (1 ano)
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  
  # CSS e JavaScript (1 ano)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"
  
  # Fontes (1 ano)
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82___lsphp .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit